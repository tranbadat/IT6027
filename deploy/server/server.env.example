# Cấu hình máy chủ thật cho `make server-up` (docs/server-deployment.md).
# server-up tạo deploy/server/server.env từ file này ở lần chạy đầu và ghi mật khẩu tự sinh vào đó.
# server.env chứa mật khẩu: không commit.

# Dashboard realtime (gateway).
WAF_DOMAIN=waf.tranbadat.vn
# Mailpit: xem email cảnh báo.
MAIL_DOMAIN=mail.tranbadat.vn
# Các site demo được giám sát, cách nhau bằng dấu cách.
DEMO_DOMAINS="service1.tranbadat.vn service2.tranbadat.vn service3.tranbadat.vn"

# Scheme người dùng thấy: Cloudflare phục vụ HTTPS rồi nối về máy chủ bằng HTTP.
PUBLIC_SCHEME=https

# true: tin header CF-Connecting-IP từ dải IP của Cloudflare để log ghi IP thật của client.
# Bắt buộc khi DNS đi qua Cloudflare (proxied), nếu không mọi request mang IP của Cloudflare.
BEHIND_CLOUDFLARE=true

# Stack quan sát (Prometheus, Grafana, Loki, exporter). Máy chủ ít tài nguyên: false.
OBSERVABILITY=false

# Tài khoản đăng nhập dashboard (P2 AUTH_CLIENTS). Mật khẩu rỗng = server-up tự sinh.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Tài khoản đăng nhập trang Mailpit (Nginx basic auth). Mật khẩu rỗng = server-up tự sinh.
MAIL_UI_USER=admin
MAIL_UI_PASSWORD=
