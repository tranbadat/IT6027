# LOẠI 3 — Platform. Copy thành .env (hoặc dùng `make deploy-init` để sinh secret ngẫu nhiên).
# Pipeline/Sensor/Observability nối Kafka qua waf-net (kafka:19092), không cần secret bus.

POSTGRES_USER=waf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waf
JWT_SECRET=change-me-to-a-long-random-string
# Mật khẩu role CHỈ-ĐỌC cho Grafana đọc lịch sử (khớp với deploy/observability/.env).
GRAFANA_DB_PASSWORD=change-me

# Domain/ứng dụng được phép xử lý (seed cho P1 Scope). Thêm domain của app mới vào đây
# hoặc gọi API POST /api/scope/allowlist.
SCOPE_ALLOWLIST=shop.local,blog.local,shop-app

# dev = bật webhook-sink nhận cảnh báo; docs = bật Swagger UI. Bỏ trống nếu chạy "sạch".
COMPOSE_PROFILES=dev,docs

# Cổng publish ra host.
GATEWAY_PORT=8080
# Kafka listener EXTERNAL cho Sensor/Pipeline ở MÁY KHÁC. Mặc định chỉ bind 127.0.0.1.
# ⚠ PLAINTEXT không xác thực: muốn mở ra mạng (KAFKA_EXTERNAL_BIND=0.0.0.0) phải chặn bằng
#   firewall chỉ cho IP sensor, hoặc bật SASL/TLS. KAFKA_EXTERNAL_HOST = IP/hostname máy Platform.
KAFKA_EXTERNAL_BIND=127.0.0.1
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9092
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
WEBHOOK_SINK_PORT=4020
SWAGGER_UI_PORT=8090

LOG_LEVEL=info
