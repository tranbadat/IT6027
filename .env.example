# Nhánh c1 — Log Collection. Copy thành .env (hoặc `make init` sinh mật khẩu ngẫu nhiên).
RABBITMQ_USER=waf
RABBITMQ_PASSWORD=change-me

# Scope Service: mặc định dùng mock (không cần Người 3). Sau này trỏ P1 thật: http://p1-scope:8000
SCOPE_SERVICE_URL=http://mock-api

# Cổng publish ra host (chỉ bind 127.0.0.1)
WEB_NGINX_PORT=8081
WEB_APACHE_PORT=8082
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
MOCK_API_PORT=4010

LOG_LEVEL=info
