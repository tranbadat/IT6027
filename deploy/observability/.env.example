# QUAN SÁT. Copy thành .env (hoặc `make deploy-init`).
# Kafka của Platform trên network waf-net.
EVENT_BUS_URL=kafka:19092

# Datasource Postgres của Grafana — dùng role CHỈ-ĐỌC grafana_ro (khớp Platform GRAFANA_DB_PASSWORD).
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=change-me
POSTGRES_DB=waf

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOG_LEVEL=info
