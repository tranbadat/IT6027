# LOẠI 1 — Sensor (cắm vào Nginx/Apache của một app). Copy thành .env (hoặc `make deploy-init`).
# EVENT_BUS_URL phải khớp user/mật khẩu RabbitMQ của Platform.

EVENT_BUS_URL=amqp://waf:change-me@rabbitmq:5672/
SCOPE_SERVICE_URL=http://p1-scope:8000

# Domain của app này. BẮT BUỘC khi file log là access.log (không suy được từ tên file).
# Bỏ trống nếu app ghi log theo <domain>.access.log. Domain phải nằm trong scope của Platform.
C1_DOMAIN=

# CẮM VÀO APP THẬT: trỏ tới thư mục log của web server (chỉ đọc). Bỏ trống để dùng web demo.
# SENSOR_NGINX_LOG_DIR=/var/log/nginx
# SENSOR_APACHE_LOG_DIR=/var/log/apache2

# false = chỉ đọc dòng log MỚI phát sinh sau khi sensor chạy (đúng realtime).
# true  = đọc lại từ đầu file hiện có.
C1_READ_EXISTING=false

# demo = kèm web-nginx thử nghiệm ở cổng 8081. Bỏ trống khi cắm vào app thật.
COMPOSE_PROFILES=demo
WEB_NGINX_PORT=8081
LOG_LEVEL=info
