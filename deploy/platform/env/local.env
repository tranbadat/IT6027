# Môi trường local (mặc định: make deploy-up): cảnh báo vào các dịch vụ giả lập chạy cùng stack.
#   Email -> Mailpit (xem tại http://localhost:8025),
#   webhook -> webhook-sink (xem bằng `docker logs waf-platform-webhook-sink-1`).
# Cấu hình ở đây GHI ĐÈ giá trị cùng tên trong .env. Secret (mật khẩu SMTP...) chỉ đặt trong .env.

# mail = Mailpit; dev = webhook-sink; docs = Swagger UI.
COMPOSE_PROFILES=mail,dev,docs

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
ALERT_EMAIL_FROM=waf-alerts@waf.local
ALERT_EMAIL_TO=soc@waf.local
ALERT_WEBHOOK_URL=http://webhook-sink:8080/alerts
