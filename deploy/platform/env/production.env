# Môi trường production: máy chủ thật, dựng bằng `make server-up` (xem docs/server-deployment.md).
#   Nginx của máy chủ (không chạy Docker) đứng trước gateway (dashboard) và Mailpit; chỉ Mailpit được
#   giữ lại trong số các dịch vụ phụ, không có webhook-sink và Swagger UI.
# Cấu hình ở đây GHI ĐÈ giá trị cùng tên trong .env. Secret và giá trị riêng của máy chủ (AUTH_CLIENTS,
# DASHBOARD_LINKS, GATEWAY_TRUSTED_PROXY, SCOPE_ALLOWLIST) do server-up ghi vào .env.

COMPOSE_PROFILES=mail

# Email cảnh báo vào Mailpit; xem qua https://<MAIL_DOMAIN> (Nginx của máy chủ yêu cầu đăng nhập).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
SMTP_TLS_VERIFY=true
ALERT_EMAIL_FROM=waf-alerts@waf.local
ALERT_EMAIL_TO=soc@waf.local
ALERT_WEBHOOK_URL=

# Gateway chỉ nghe trên 127.0.0.1; truy cập từ ngoài đi qua Nginx của máy chủ.
GATEWAY_BIND=127.0.0.1

# Không cấp token cho client bất kỳ: chỉ tài khoản trong AUTH_CLIENTS (.env) đăng nhập được dashboard.
AUTH_ALLOW_ANY=false
