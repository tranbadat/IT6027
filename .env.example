# Sao chép thành .env bằng `make init` (tự sinh mật khẩu ngẫu nhiên) hoặc `cp .env.example .env`.
# KHÔNG commit file .env.

# Profile bật thêm ngoài phần hạ tầng mặc định, phân tách bằng dấu phẩy.
#   app         cả 11 service ứng dụng C1–C3, D1–D3, P1–P5 (toàn bộ pipeline)
#   mock        webhook sink (+ mock Scope/Auth khi chưa dùng P1/P2 thật)
#   docs        Swagger UI xem OpenAPI contract
#   apache      web server Apache mục tiêu (ngoài Nginx)
#   c1..c3, d1..d3, p1..p5   bật lẻ từng service
#   collection, detection, platform   bật theo nhóm (Người 1 / 2 / 3)
# Chạy toàn hệ thống: mock,docs,app. Chạy hạ tầng + mock (chưa có service): mock,docs.
COMPOSE_PROFILES=mock,docs,app

# --- Thông tin đăng nhập (đổi trước khi dùng) ---
RABBITMQ_USER=waf
RABBITMQ_PASSWORD=change-me
POSTGRES_USER=waf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waf
JWT_SECRET=change-me-to-a-long-random-string

# --- Scope/Auth: mặc định dùng P1/P2 THẬT (profile app). Muốn dùng mock thì đổi thành
#     http://mock-api (và giữ profile mock). Đổi xong chạy `make up`. ---
SCOPE_SERVICE_URL=http://p1-scope:8000
AUTH_SERVICE_URL=http://p2-auth:8000
RULES_SERVICE_URL=http://d2-rule-manager:8000
PIPELINE_SERVICE_URL=http://p3-orchestrator:8000
ALERTING_SERVICE_URL=http://p4-alerting:8000
DASHBOARD_SERVICE_URL=http://p5-dashboard:8000

# --- Cổng publish ra máy host (chỉ bind 127.0.0.1) ---
GATEWAY_PORT=8080
WEB_NGINX_PORT=8081
WEB_APACHE_PORT=8082
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MOCK_API_PORT=4010
WEBHOOK_SINK_PORT=4020
SWAGGER_UI_PORT=8090

LOG_LEVEL=info
