# LOẠI 2 — Pipeline. Copy thành .env (hoặc `make deploy-init`).
# Cùng máy / cùng network waf-net: dùng tên service "kafka" và "p1-scope" của stack Platform.
# Máy khác: EVENT_BUS_URL=<ip-platform>:9092 (listener EXTERNAL, xem deploy/platform/.env.example).
EVENT_BUS_URL=kafka:19092
SCOPE_SERVICE_URL=http://p1-scope:8000

# Ngưỡng điểm phát cảnh báo của detector (1–100).
ALERT_SCORE_THRESHOLD=70
LOG_LEVEL=info
