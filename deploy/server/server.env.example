# Cấu hình máy chủ thật cho `make server-up` (docs/server-deployment.md).
# server-up tạo deploy/server/server.env từ file này ở lần chạy đầu và ghi mật khẩu tự sinh vào đó.
# server.env chứa mật khẩu: không commit.

# Dashboard realtime (gateway).
WAF_DOMAIN=waf.tranbadat.vn
# Mailpit: xem email cảnh báo.
MAIL_DOMAIN=mailpit.tranbadat.vn
# Các site demo được giám sát, cách nhau bằng dấu cách.
DEMO_DOMAINS="service1.tranbadat.vn service2.tranbadat.vn service3.tranbadat.vn"

# Cách người dùng truy cập các domain trên:
#   cloudflare    DNS proxied qua Cloudflare: Cloudflare phục vụ HTTPS và nối về máy chủ bằng HTTP
#                 (SSL/TLS = Flexible); log lấy IP thật của client từ header CF-Connecting-IP.
#   direct-https  DNS trỏ thẳng về máy chủ: server-up tự lấy chứng chỉ Let's Encrypt (DNS phải trỏ đúng và
#                 cổng 80, 443 mở trước khi chạy), HTTP được chuyển sang HTTPS, chứng chỉ tự gia hạn.
#   direct-http   DNS trỏ thẳng về máy chủ, chỉ HTTP, không mã hoá: chỉ nên dùng thử.
ACCESS_MODE=cloudflare

# direct-https: email nhận thông báo của Let's Encrypt (chứng chỉ sắp hết hạn...). Rỗng = không đăng ký email.
LETSENCRYPT_EMAIL=
# direct-https: true = lấy chứng chỉ thử (trình duyệt không tin, không bị giới hạn số lần cấp của Let's Encrypt).
LETSENCRYPT_STAGING=false

# Stack quan sát (Prometheus, Grafana, Loki, exporter). Máy chủ ít tài nguyên: false.
OBSERVABILITY=false

# Tài khoản đăng nhập dashboard (P2 AUTH_CLIENTS). Mật khẩu rỗng = server-up tự sinh.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Tài khoản đăng nhập trang Mailpit (Nginx basic auth). Mật khẩu rỗng = server-up tự sinh.
MAIL_UI_USER=admin
MAIL_UI_PASSWORD=
