# WAF Log Analyzer: dashboard và Mailpit. Sinh bởi scripts/server-up.sh từ
# deploy/server/nginx/waf-platform.conf.template; sửa template rồi chạy lại make server-up.

# Dashboard realtime -> gateway (Docker, chỉ nghe 127.0.0.1)
server {
    listen @@LISTEN@@;
    listen [::]:@@LISTEN@@;
    include @@SERVER_SNIPPET@@;
    server_name @@WAF_DOMAIN@@;
    server_tokens off;
    client_max_body_size 1m;
    access_log /var/log/nginx/waf-dashboard.access.log;
    error_log  /var/log/nginx/waf-dashboard.error.log warn;

    # IP của client như Nginx thấy (sau khi lấy IP thật qua Cloudflare nếu có); kịch bản e2e dùng để đối chiếu.
    location = /_waf/client-ip {
        default_type text/plain;
        return 200 "$remote_addr\n";
    }

    location / {
        proxy_pass http://127.0.0.1:@@GATEWAY_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $waf_forwarded_proto;
        proxy_set_header Connection        "";
        # Luồng sự kiện realtime (SSE): không buffer, giữ kết nối lâu. P5 gửi keep-alive mỗi 15 giây,
        # dưới giới hạn 100 giây không có dữ liệu của Cloudflare.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}

# Mailpit (email cảnh báo) -> Docker 127.0.0.1, yêu cầu đăng nhập
server {
    listen @@LISTEN@@;
    listen [::]:@@LISTEN@@;
    include @@SERVER_SNIPPET@@;
    server_name @@MAIL_DOMAIN@@;
    server_tokens off;
    access_log /var/log/nginx/waf-mailpit.access.log;
    error_log  /var/log/nginx/waf-mailpit.error.log warn;

    auth_basic "Mailpit";
    auth_basic_user_file @@MAIL_HTPASSWD@@;

    location / {
        proxy_pass http://127.0.0.1:@@MAILPIT_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $waf_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
