
# ACCESS_MODE=direct-https: cổng 80 chỉ phục vụ xác minh Let's Encrypt và chuyển mọi request sang HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name @@ALL_DOMAINS@@;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root @@ACME_ROOT@@;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
