# Docker images and exposed broker port
KAFKA_IMAGE=apache/kafka:4.1.0
KAFKA_HOST_PORT=9092
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.4.2
KAFKA_UI_PORT=8080
KAFKA_UI_CLUSTER_NAME=waf-local
DETECTOR_IMAGE_TAG=local
SIMULATOR_IMAGE_TAG=local

# Kafka topics and consumer groups
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_INPUT_TOPIC=web.requests.v1
KAFKA_DOMAIN_TOPIC=web.requests.by-domain.v1
KAFKA_OUTPUT_TOPIC=security.detections.v1
KAFKA_DLQ_TOPIC=security.invalid.v1
KAFKA_CONSUMER_GROUP=waf-detector-v2
KAFKA_REPARTITION_GROUP=waf-repartition-v2
KAFKA_DDOS_GROUP=waf-ddos-v2
KAFKA_INPUT_PARTITIONS=6
KAFKA_DOMAIN_PARTITIONS=6
KAFKA_OUTPUT_PARTITIONS=6
KAFKA_DLQ_PARTITIONS=3

# Rule and anomaly scoring
REQUEST_WINDOW_SECONDS=60
REQUEST_THRESHOLD=20
ERROR_THRESHOLD=8
DISTINCT_PATH_THRESHOLD=12
ALERT_SCORE_THRESHOLD=70
RULE_ALERT_COOLDOWN_SECONDS=15
MAX_FUTURE_SKEW_SECONDS=300
MAX_TRACKED_CLIENTS=100000
EMIT_ONLY_ALERTS=false

# DDoS detection
DDOS_WINDOW_SECONDS=10
DDOS_REQUESTS_THRESHOLD=300
DDOS_UNIQUE_IPS_THRESHOLD=20
DDOS_COOLDOWN_SECONDS=10
MAX_TRACKED_DOMAINS=10000

# Kafka batches
RULE_BATCH_SIZE=200
REPARTITION_BATCH_SIZE=500
DDOS_BATCH_SIZE=500

# Optional simulator profile
SIM_RATE=20
SIM_DURATION=120
SIM_MODE=mixed
SIM_SEED=42
