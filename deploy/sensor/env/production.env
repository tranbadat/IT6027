# Môi trường production: C1 đọc log của Nginx chạy trực tiếp trên máy chủ (không có web demo Docker).
# Cấu hình ở đây GHI ĐÈ giá trị cùng tên trong .env.

COMPOSE_PROFILES=

# Thư mục chỉ chứa access log của các site cần giám sát (<domain>.access.log, định dạng waf_combined),
# do server-up cấu hình trong Nginx của máy chủ.
SENSOR_NGINX_LOG_DIR=/var/log/nginx/waf

# Sau logrotate, file log được tạo lại với quyền 0640 www-data:adm. adm có gid 4 trên Ubuntu/Debian:
# thêm nhóm này cho C1 để vẫn đọc được log.
SENSOR_LOG_GID=4
