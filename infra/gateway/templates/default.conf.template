# API Gateway (P2 routing). File này được entrypoint của image nginx render bằng envsubst
# thành /etc/nginx/conf.d/default.conf; chỉ các biến ${...} có trong environment bị thay.
#
# Upstream đặt qua biến nên nginx vẫn khởi động khi service đích chưa chạy (trả 502 JSON),
# và chuyển mock → service thật chỉ cần đổi *_SERVICE_URL trong .env.

resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 2s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=api_rl:10m  rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth_rl:10m rate=10r/m;
limit_req_status 429;

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 1m;

    set $auth_upstream      ${AUTH_SERVICE_URL};
    set $scope_upstream     ${SCOPE_SERVICE_URL};
    set $rules_upstream     ${RULES_SERVICE_URL};
    set $pipeline_upstream  ${PIPELINE_SERVICE_URL};
    set $alerting_upstream  ${ALERTING_SERVICE_URL};
    set $dashboard_upstream ${DASHBOARD_SERVICE_URL};

    error_page 401 = @unauthorized;
    error_page 429 = @rate_limited;
    error_page 500 502 503 504 = @unavailable;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Subrequest xác thực: P2 trả 2xx nếu JWT hợp lệ, 401 nếu không.
    location = /_auth {
        internal;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        rewrite ^ /auth/verify break;
        proxy_pass $auth_upstream;
    }

    # ---- Public: chỉ riêng endpoint cấp token ----
    location = /api/auth/token {
        limit_req zone=auth_rl burst=5 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header X-Auth-Subject "";
        proxy_set_header X-Auth-Roles "";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $auth_upstream;
    }

    # ---- Cần JWT ----
    location /api/auth/ {
        set $upstream $auth_upstream;
        include /etc/nginx/snippets/protected.conf;
    }

    location /api/scope/ {
        set $upstream $scope_upstream;
        include /etc/nginx/snippets/protected.conf;
    }

    location /api/rules/ {
        set $upstream $rules_upstream;
        include /etc/nginx/snippets/protected.conf;
    }

    location /api/pipelines/ {
        set $upstream $pipeline_upstream;
        include /etc/nginx/snippets/protected.conf;
    }

    location /api/alerts/ {
        set $upstream $alerting_upstream;
        include /etc/nginx/snippets/protected.conf;
    }

    location /api/dashboard/ {
        set $upstream $dashboard_upstream;
        include /etc/nginx/snippets/protected.conf;
        include /etc/nginx/snippets/streaming.conf;
    }

    # API của P5 nằm dưới /dashboard/ và chỉ được gọi qua /api/dashboard/ (có JWT).
    # Chặn đường tắt đi qua location / bên dưới.
    location = /dashboard {
        default_type application/json;
        return 404 '{"error":"not_found","message":"use /api/dashboard/"}';
    }

    location ^~ /dashboard/ {
        default_type application/json;
        return 404 '{"error":"not_found","message":"use /api/dashboard/"}';
    }

    # ---- Giao diện dashboard (P5 tự xử lý đăng nhập phía client) ----
    location / {
        limit_req zone=api_rl burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/streaming.conf;
        proxy_set_header X-Auth-Subject "";
        proxy_set_header X-Auth-Roles "";
        proxy_pass $dashboard_upstream;
    }

    location @unauthorized {
        default_type application/json;
        add_header WWW-Authenticate 'Bearer realm="waf"' always;
        return 401 '{"error":"unauthorized","message":"missing or invalid bearer token"}';
    }

    location @rate_limited {
        default_type application/json;
        return 429 '{"error":"rate_limited","message":"too many requests"}';
    }

    location @unavailable {
        default_type application/json;
        return 502 '{"error":"upstream_unavailable","message":"target service is not running or not reachable"}';
    }
}
