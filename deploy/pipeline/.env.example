# LOẠI 2 — Pipeline. Copy thành .env (hoặc `make deploy-init`).
# EVENT_BUS_URL phải chứa ĐÚNG user/mật khẩu RabbitMQ của stack Platform.

# Cùng máy / cùng network waf-net: dùng tên service "rabbitmq" và "p1-scope".
# Máy khác: thay bằng host:port của Platform, vd amqp://waf:pass@10.0.0.5:5672/
EVENT_BUS_URL=amqp://waf:change-me@rabbitmq:5672/
SCOPE_SERVICE_URL=http://p1-scope:8000

ANOMALY_THRESHOLD=70
LOG_LEVEL=info
